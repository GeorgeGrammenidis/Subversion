--- !u!114 &51079775
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 51079772}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 651d75a0c40bc5a48be49d370230d750, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - 'Rosa:  Master, you survived the incident.'
  - 'Master:  It appears you also survived.'
  - 'Rosa:   You are right. But how? I just committed suicide.'
  - 'Master:   You think you can escape torment that easily? Your soul is carried
    from body to body.'
  - 'Rosa:  I am a reincarnation? But how can that be? I retain my memories, age
    and physical appearance.'
  - 'Master:  In this realm I am not engaging with the physical version of you but
    with the abstract concept of you.'
  - 'Rosa:  How do I escape then?'
  - 'Master: The religions of the east claim your soul has to escape the cycle of
    reincarnation.  Like the flame of a candle being blown away.'
  dialogueManager: {fileID: 605459489}
  autoTrigger: 1
  player: {fileID: 2038367849}
  hasSpoken: 0
  X: -1000
  Y: 21
  X2: 1000
  Y2: 1000
