      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: X
      value: -100
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: Y
      value: 172
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: X2
      value: 200
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: Y2
      value: 200
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: player
      value: 
      objectReference: {fileID: 1733340321}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueManager
      value: 
      objectReference: {fileID: 798425910}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 24
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: 'Rosa:  Why? Why am I here? I managed to terminate the cycle of physical
        reincarnation.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: 'Irene:   You failed to account for the consciousness existing independently
        of the body.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "Rosa:  \u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: 'Irene:  You do not seem okay.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: 'Rosa:  Well yes I am talking to you.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[5]
      value: 'Irene:  And why is that a bad thing? I thought you loved me.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[6]
      value: 'Rosa:  Well I did love you. I would normally love seeing you again.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[7]
      value: 'Irene:  What is the issue then?'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[8]
      value: 'Rosa:   I witnessed you dying during the incident. Among all the others.
        I know you are not real.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[9]
      value: 'Irene:  And how do you know that I am not real now and what you thought
        you witnessed was not the actual illusion?'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[10]
      value: 'Rosa:  My perception cannot be trusted anymore.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[11]
      value: 'Irene:  Can anyone ever trust theirs at any point?'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[12]
      value: 'Rosa:   What do you mean?'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[13]
      value: 'Irene:  Let me give you an example. '
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[14]
      value: 'Irene: I am not saying everyone around you secretly hates you.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[15]
      value: 'Irene: I am not saying they are only pretending to be nice just to
        avoid you emotionally crashing out.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[16]
      value: 'Irene:  But if that was the case, do you think you would be able to
        tell?'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[17]
      value: "Rosa:  \u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[18]
      value: 'Irene:  Why would you trust your own perception? It''s not like you
        have never put your trust to someone who betrayed you before.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[19]
      value: 'Rosa:  Please help me.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[20]
      value: 'Irene:  You want my advice? Seek the Powers That Be.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[21]
      value: 'Rosa:  Who? '
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[22]
      value: 'Irene:  Goodbye.'
      objectReference: {fileID: 0}
    - target: {fileID: 4277690341762302678, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: dialogueLines.Array.data[23]
      value: 'Rosa:  WAIT.'
      objectReference: {fileID: 0}
    - target: {fileID: 4747664447449791867, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: 5b3174f2fb8860242915e6a46d891416, type: 3}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 1e8c928c21f4adb41a3a08e199212d1a, type: 3}
